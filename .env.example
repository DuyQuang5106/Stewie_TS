NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/stewiesat_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
READ_API_ENABLED=false
# Required only when READ_API_ENABLED=true: same raw UTF-8 secret as Java app.jwtSecret.
# APP_JWTSECRET=CHANGE_ME_TO_THE_SAME_SECRET_AS_JAVA

# Keep disabled until writes are explicitly needed on a dedicated development database.
ACADEMIC_WRITE_API_ENABLED=false

VOCABULARY_API_ENABLED=false
ASSESSMENT_API_ENABLED=false
# DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# Enable only after the Java scheduler is disabled for the same database.
ASSESSMENT_SCHEDULER_ENABLED=false

ANALYTICS_API_ENABLED=false

# Authentication endpoints are opt-in. Dev login must stay disabled on servers.
AUTH_API_ENABLED=false
AUTH_DEV_LOGIN_ENABLED=false
AUTH_CLEANUP_ENABLED=false
AUTH_COOKIE_SECURE=false
APP_JWTEXPIRATIONMS=900000
APP_JWTREFRESHEXPIRATIONMS=604800000
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CALLBACK_URI=http://localhost:3001/login/oauth2/code/google
APP_OAUTH2_REDIRECTURI=http://localhost:3000/oauth2/redirect
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
