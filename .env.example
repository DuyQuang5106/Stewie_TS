NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/stewiesat_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
READ_API_ENABLED=false
# Required only when READ_API_ENABLED=true: same raw UTF-8 secret as Java app.jwtSecret.
# APP_JWTSECRET=CHANGE_ME_TO_THE_SAME_SECRET_AS_JAVA

# Keep disabled until writes are explicitly needed on a dedicated development database.
ACADEMIC_WRITE_API_ENABLED=false

VOCABULARY_API_ENABLED=false
ASSESSMENT_API_ENABLED=false
# DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# Enable only after the Java scheduler is disabled for the same database.
ASSESSMENT_SCHEDULER_ENABLED=false
