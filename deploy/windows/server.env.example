# Copy to .env in this directory. Never commit the real file.
PUBLIC_ORIGIN=https://stewiesat.com
# Change only when initializing a NEW database volume.
POSTGRES_DB=stiu_prod
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
# URL-encode special characters in this URL password; match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:CHANGE_ME_RANDOM_DATABASE_PASSWORD@database:5432/stiu_prod
# Preserve the existing JWT secret if you need compatibility with existing sessions.
APP_JWTSECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
TZ=Etc/UTC
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
TUNNEL_TOKEN=CHANGE_ME
# Local build tags initially. Replace with immutable GHCR tags when published.
BACKEND_IMAGE=stw-ts:server-candidate
FRONTEND_IMAGE=stiu-fe:server-candidate
# Pin a tested cloudflared release/digest before launch.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Enable only after confirming Java no longer owns these jobs.
ASSESSMENT_SCHEDULER_ENABLED=false
AUTH_CLEANUP_ENABLED=false
